{
	"name": "ethaor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "npm run wasm",
		"build": "vite build",
		"postbuild": "node scripts/preload.mjs",
		"preview": "vite preview",
		"host": "vite preview --host 0.0.0.0 --port 8080",
		"deploy": "npm run build && wrangler pages deploy build --project-name ethaor",
		"wasm": "node scripts/copy-wasm.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^25.2.3",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"wrangler": "^4.151.0"
	},
	"dependencies": {
		"@fontsource-variable/noto-serif-hebrew": "^5.3.0",
		"@sveltejs/kit": "^2.51.0",
		"svelte": "^5.51.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
