{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "NotebookEdit(*)",
      "mcp__supabase__execute_sql"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(cargo fmt*)",
      "Bash(cargo +* fmt*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/.ssh/**)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
